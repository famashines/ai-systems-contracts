{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "text": {
      "type": "string",
      "maxLength": 20000,
      "pattern": "^(?=[^\\0]*\\S)[^\\0]*$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "approval"
      ]
    },
    "conversationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "messageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "model": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[\\w.-]+\\/[\\w.:-]+$"
    },
    "effort": {
      "type": "string",
      "enum": [
        "max",
        "xhigh",
        "high",
        "medium",
        "low",
        "minimal",
        "none"
      ]
    }
  },
  "required": [
    "taskId",
    "text",
    "mode"
  ],
  "description": "The owner sent a task. `conversationId` and `messageId` are present when it comes from the chat. `model` and `effort` are the choice of the owner for all calls of the task; absent means the model chain of each agent and no effort."
}
