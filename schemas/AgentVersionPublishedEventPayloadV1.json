{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "prompt": {
      "type": "object",
      "properties": {
        "promptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "promptId",
        "version"
      ]
    },
    "models": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[\\w.-]+\\/[\\w.:-]+$"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "maxCostMicroUsd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxCalls",
        "maxTokens",
        "maxCostMicroUsd"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "agentId",
    "prompt",
    "models",
    "limits",
    "version"
  ],
  "description": "A new immutable version of an agent: prompt version, models (default first, then the fallback chain), limits."
}
