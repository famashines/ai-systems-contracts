{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "approval"
      ]
    }
  },
  "required": [
    "taskId",
    "mode"
  ],
  "description": "The owner changed the mode of the task: `auto` or `approval`."
}
