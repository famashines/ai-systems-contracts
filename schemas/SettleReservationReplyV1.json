{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "settled",
            "already_settled"
          ]
        },
        "reservationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "actualMicroUsd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "state",
        "reservationId",
        "actualMicroUsd"
      ]
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "expired"
        },
        "reservationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "amountMicroUsd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "state",
        "reservationId",
        "amountMicroUsd"
      ]
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "unknown"
        },
        "reservationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "state",
        "reservationId"
      ]
    }
  ]
}
