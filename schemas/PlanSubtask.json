{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subtaskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(?=[^\\0]*\\S)[^\\0]*$"
    },
    "instructions": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^(?=[^\\0]*\\S)[^\\0]*$"
    },
    "agentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "model": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[\\w.-]+\\/[\\w.:-]+$"
    },
    "dependsOn": {
      "maxItems": 19,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "needsApproval": {
      "type": "boolean"
    },
    "estimatedCostMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "estimatedDurationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    }
  },
  "required": [
    "subtaskId",
    "title",
    "instructions",
    "agentId",
    "dependsOn",
    "needsApproval"
  ]
}
