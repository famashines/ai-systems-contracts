{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reservationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reservedMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actualMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "reservationId",
    "reservedMicroUsd",
    "actualMicroUsd"
  ],
  "description": "The real cost is booked and the rest of the hold is free."
}
