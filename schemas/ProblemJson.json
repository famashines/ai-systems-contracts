{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "enum": [
        "validation_failed",
        "not_found",
        "conflict",
        "unauthorized",
        "forbidden",
        "rate_limited",
        "internal",
        "unavailable",
        "budget_refused",
        "method_not_allowed",
        "payload_too_large",
        "unsupported_media_type",
        "runaway_stopped",
        "empty_output",
        "subtask_failed"
      ]
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "code"
  ]
}
