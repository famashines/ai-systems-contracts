{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "maxLength": 7,
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "capMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "softCapMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "spentMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reservedMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remainingMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "month",
    "capMicroUsd",
    "spentMicroUsd",
    "reservedMicroUsd",
    "remainingMicroUsd",
    "rev"
  ]
}
