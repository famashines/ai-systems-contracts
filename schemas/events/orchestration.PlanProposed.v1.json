{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "type": "string",
      "const": "orchestration.PlanProposed"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "streamId": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9]*-\\S+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "causationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "planVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "subtasks": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subtaskId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "title": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^(?=[^\\0]*\\S)[^\\0]*$"
              },
              "instructions": {
                "type": "string",
                "maxLength": 4000,
                "pattern": "^(?=[^\\0]*\\S)[^\\0]*$"
              },
              "agentId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "model": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[\\w.-]+\\/[\\w.:-]+$"
              },
              "dependsOn": {
                "maxItems": 19,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "needsApproval": {
                "type": "boolean"
              },
              "estimatedCostMicroUsd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "estimatedDurationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000
              }
            },
            "required": [
              "subtaskId",
              "title",
              "instructions",
              "agentId",
              "dependsOn",
              "needsApproval"
            ]
          }
        },
        "awaitsApproval": {
          "type": "boolean"
        }
      },
      "required": [
        "taskId",
        "planVersion",
        "subtasks",
        "awaitsApproval"
      ],
      "description": "A plan with subtasks, dependencies (a DAG), agents, and cost and time estimates. `planVersion` goes up by 1 for each new plan of the task. `awaitsApproval` is false in auto mode, where `PlanApproved` follows."
    }
  },
  "required": [
    "eventId",
    "type",
    "schemaVersion",
    "streamId",
    "version",
    "occurredAt",
    "correlationId",
    "causationId",
    "actor",
    "payload"
  ]
}
