{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "type": "string",
      "const": "llm.CallCompleted"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "streamId": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9]*-\\S+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "causationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "callId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "model": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[\\w.-]+\\/[\\w.:-]+$"
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "finishReason": {
          "type": "string",
          "enum": [
            "stop",
            "length",
            "tool_calls",
            "content_filter"
          ]
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cachedTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costMicroUsd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bodyId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "taskId",
        "callId",
        "attempt",
        "model",
        "text",
        "finishReason",
        "inputTokens",
        "outputTokens",
        "cachedTokens",
        "costMicroUsd",
        "latencyMs",
        "bodyId"
      ],
      "description": "The call is done: output text, tokens, cost in micro-USD, latency, and the id of the stored request and response."
    }
  },
  "required": [
    "eventId",
    "type",
    "schemaVersion",
    "streamId",
    "version",
    "occurredAt",
    "correlationId",
    "causationId",
    "actor",
    "payload"
  ]
}
