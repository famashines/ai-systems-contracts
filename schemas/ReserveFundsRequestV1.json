{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reservationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "callId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scopes": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "month"
              },
              "key": {
                "type": "string",
                "maxLength": 7,
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              }
            },
            "required": [
              "kind",
              "key"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "project",
                  "agent",
                  "task"
                ]
              },
              "key": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "kind",
              "key"
            ]
          }
        ]
      }
    },
    "worstCaseMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxDurationMs": {
      "default": 600000,
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    }
  },
  "required": [
    "reservationId",
    "callId",
    "scopes",
    "worstCaseMicroUsd"
  ]
}
