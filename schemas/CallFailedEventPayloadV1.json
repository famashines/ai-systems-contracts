{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "callId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[\\w.-]+\\/[\\w.:-]+$"
    },
    "errorClass": {
      "type": "string",
      "enum": [
        "rate_limit",
        "timeout",
        "provider",
        "invalid",
        "budget_refused",
        "cancelled"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "costMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nextModel": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[\\w.-]+\\/[\\w.:-]+$"
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bodyId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reservationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "taskId",
    "callId",
    "attempt",
    "model",
    "errorClass",
    "reason",
    "costMicroUsd"
  ],
  "description": "One attempt failed. `nextModel` is the next model of the fallback chain; absent means that the call failed."
}
