{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "questions": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000,
        "pattern": "^(?=[^\\0]*\\S)[^\\0]*$"
      }
    }
  },
  "required": [
    "taskId",
    "questions"
  ],
  "description": "The orchestrator needs answers before it plans. Only a task with a `conversationId` asks questions."
}
