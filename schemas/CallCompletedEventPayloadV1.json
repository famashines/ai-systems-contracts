{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "callId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[\\w.-]+\\/[\\w.:-]+$"
    },
    "text": {
      "type": "string",
      "maxLength": 100000,
      "pattern": "^[^\\0]*$"
    },
    "finishReason": {
      "type": "string",
      "enum": [
        "stop",
        "length",
        "tool_calls",
        "content_filter"
      ]
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cachedTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "costMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bodyId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "callInputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "callOutputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "callCostMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    }
  },
  "required": [
    "taskId",
    "callId",
    "attempt",
    "model",
    "text",
    "finishReason",
    "inputTokens",
    "outputTokens",
    "cachedTokens",
    "costMicroUsd",
    "latencyMs",
    "bodyId"
  ],
  "description": "The call is done: output text, tokens, cost in micro-USD, latency, and the id of the stored request and response. `callInputTokens`, `callOutputTokens` and `callCostMicroUsd` are the totals of all attempts of the call."
}
