{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subtaskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tryNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "code": {
      "type": "string",
      "enum": [
        "validation_failed",
        "not_found",
        "conflict",
        "unauthorized",
        "forbidden",
        "rate_limited",
        "internal",
        "unavailable",
        "budget_refused",
        "method_not_allowed",
        "payload_too_large",
        "unsupported_media_type",
        "runaway_stopped",
        "empty_output",
        "subtask_failed"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "costMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    }
  },
  "required": [
    "taskId",
    "runId",
    "subtaskId",
    "tryNumber",
    "code",
    "reason",
    "inputTokens",
    "outputTokens",
    "costMicroUsd"
  ],
  "description": "One try of the subtask failed, with a code, a plain reason, and the tokens and cost of the try. `SubtaskRetrying` follows when a try is left, else `RunBlocked` with the code `subtask_failed`."
}
