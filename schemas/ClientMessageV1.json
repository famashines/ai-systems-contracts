{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "v": {
          "type": "number",
          "const": 1
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "lastSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "v",
        "token"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "subscribe"
        },
        "topics": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "tasks",
                  "budget",
                  "agents",
                  "notifications"
                ]
              },
              {
                "type": "string",
                "pattern": "^task:([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            ]
          }
        }
      },
      "required": [
        "type",
        "topics"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "unsubscribe"
        },
        "topics": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "tasks",
                  "budget",
                  "agents",
                  "notifications"
                ]
              },
              {
                "type": "string",
                "pattern": "^task:([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            ]
          }
        }
      },
      "required": [
        "type",
        "topics"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "reauth"
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "token"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ping"
        },
        "t": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "t"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pong"
        },
        "t": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "t"
      ]
    }
  ]
}
