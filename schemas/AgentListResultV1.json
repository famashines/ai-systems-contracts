{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "enabled": {
            "type": "boolean"
          },
          "activeVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "latestVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "rev": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "asOf": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "agentId",
          "name",
          "enabled",
          "rev",
          "asOf"
        ]
      }
    },
    "headSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "items",
    "headSeq"
  ]
}
