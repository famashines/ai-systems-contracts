{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[\\w.-]+\\/[\\w.:-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "efforts": {
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "max",
          "xhigh",
          "high",
          "medium",
          "low",
          "minimal",
          "none"
        ]
      }
    },
    "defaultEffort": {
      "type": "string",
      "enum": [
        "max",
        "xhigh",
        "high",
        "medium",
        "low",
        "minimal",
        "none"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "efforts"
  ]
}
